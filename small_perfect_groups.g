Read(Filename(DirectoryCurrent(),"build_sparse_F2_system_from_group.g"));

max_order := 10080;

Print("Testing all perfect groups of order ≤ ", max_order, "...\n\n");
successful_ids := [];

for n in Intersection([1..max_order], SizesPerfectGroups()) do
	for k in [1..NrPerfectGroups(n)] do
		H := PerfectGroup(n,k);
		Print("Trying PerfectGroup(", n, ",", k, ") = ", H, "... \c");
		M_H := build_sparse_F2_system_from_group(H);
		if M_H = [] then
			Print("Fail.\n");
			continue;
		fi;
		num_vars := Ncols(M_H);
		num_eqs := Nrows(M_H);
		r := Rank(TransposedSparseMat(M_H)); # with these linear systems, computing the rank turns out to be MUCH faster after first taking the transpose
		if r = num_vars then
			Print("Success!\n");
			Append(successful_ids, [[n, k]]);
		else
			Print("Fail.\n");
		fi;
	od;
od;

Print("\nSummary: the following perfect groups H of order up to ", max_order, " give rise to");
Print("\n         a linear system M_H with full column rank, so that the solution");
Print("\n         group Γ(M_H, 0) is a non-trivial perfect group:\n");
for id in successful_ids do
	Print("    PerfectGroup(", id[1], ", ", id[2], ") = ", PerfectGroup(id[1], id[2]), "\n");
od;


